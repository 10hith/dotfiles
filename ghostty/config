# Ghostty config — synced from
#   ~/Library/Application Support/com.mitchellh.ghostty/config.ghostty
# Edit either side; run ./sync_files_mac.sh to pull system -> repo.

# --- Font (matches wezterm/.wezterm.lua) ---
font-family = BlexMono Nerd Font Mono
font-size = 17

# --- Colors: coolnight (copied from wezterm/.wezterm.lua:16-26) ---
background = 011423
foreground = CBE0F0
cursor-color = 1FB8FF
selection-background = 033259
selection-foreground = CBE0F0

# ANSI 0-7
palette = 0=#214969
palette = 1=#E52E2E
palette = 2=#44FFB1
palette = 3=#FFE073
palette = 4=#0FC5ED
palette = 5=#a277ff
palette = 6=#24EAF7
palette = 7=#24EAF7
# Brights 8-15
palette = 8=#214969
palette = 9=#E52E2E
palette = 10=#44FFB1
palette = 11=#FFE073
palette = 12=#A277FF
palette = 13=#a277ff
palette = 14=#24EAF7
palette = 15=#24EAF7

# --- Window ---
background-opacity = 0.8
background-blur-radius = 20
window-decoration = true
window-padding-x = 8
window-padding-y = 8
window-padding-balance = true
window-padding-color = background
window-save-state = always
confirm-close-surface = false
quit-after-last-window-closed = true
resize-overlay = never

# --- macOS chrome: hide the title bar entirely (zellij draws its own tab bar) ---
macos-titlebar-style = hidden
macos-titlebar-proxy-icon = hidden
window-theme = dark

# --- Cursor / splits ---
cursor-style = block
cursor-style-blink = false
unfocused-split-opacity = 0.85
bold-is-bright = false

# --- Cursor shaders ---
# Trail: cursor_blaze (0xhckr/ghostty-shaders)
# Boom:  sonic_boom on cursor-mode change, e.g. vim block <-> line
#        (sahaj-b/ghostty-cursor-shaders)
custom-shader = ~/.config/ghostty/shaders/cursor_blaze.glsl
custom-shader = ~/.config/ghostty/shaders/sonic_boom_cursor.glsl
# Keep boom playing when the window loses focus (cursor goes hollow otherwise)
custom-shader-animation = always

# --- Clipboard / mouse ---
clipboard-read = allow
clipboard-write = allow
clipboard-paste-protection = true
clipboard-paste-bracketed-safe = true
clipboard-trim-trailing-spaces = true
copy-on-select = clipboard
mouse-hide-while-typing = true
mouse-scroll-multiplier = 1.5

# --- Shell / zellij ---
# Auto-launch zellij in a login zsh, like wezterm/.wezterm.lua:29
command = /bin/zsh -l -c zellij
shell-integration = zsh
shell-integration-features = cursor,sudo,title

# --- macOS / input ---
# Left Option = Alt so zellij's Alt-h/j/k/l bindings fire; right Option keeps
# native macOS composed keys (matches wezterm send_composed_key_when_*).
macos-option-as-alt = left

# Convenience keys mirroring wezterm's CTRL|SHIFT R / CTRL|SHIFT Z
keybind = super+shift+r=reload_config
keybind = super+shift+z=text:zellij\n

# --- Misc ---
scrollback-limit = 10000000
