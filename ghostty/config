# Ghostty config — synced from
#   ~/Library/Application Support/com.mitchellh.ghostty/config.ghostty
# Edit either side; run ./sync_files_mac.sh to pull system -> repo.

# --- Font (matches wezterm/.wezterm.lua) ---
font-family = BlexMono Nerd Font Mono
font-size = 17

# --- Colors: coolnight (copied from wezterm/.wezterm.lua:16-26) ---
background = 011423
foreground = CBE0F0
cursor-color = 1FB8FF
selection-background = 033259
selection-foreground = CBE0F0

# ANSI 0-7
palette = 0=#214969
palette = 1=#E52E2E
palette = 2=#44FFB1
palette = 3=#FFE073
palette = 4=#0FC5ED
palette = 5=#a277ff
palette = 6=#24EAF7
palette = 7=#24EAF7
# Brights 8-15
palette = 8=#214969
palette = 9=#E52E2E
palette = 10=#44FFB1
palette = 11=#FFE073
palette = 12=#A277FF
palette = 13=#a277ff
palette = 14=#24EAF7
palette = 15=#24EAF7

# --- Window ---
background-opacity = 0.8
background-blur-radius = 20
window-decoration = true
window-padding-x = 8
window-padding-y = 8
window-padding-balance = true
window-padding-color = background
window-save-state = always
confirm-close-surface = false
quit-after-last-window-closed = true
resize-overlay = never

# --- macOS chrome: hide the title bar entirely (zellij draws its own tab bar) ---
macos-titlebar-style = hidden
macos-titlebar-proxy-icon = hidden
window-theme = dark

# --- Cursor / splits ---
cursor-style = block
cursor-style-blink = false
unfocused-split-opacity = 0.85
bold-is-bright = false

# --- Cursor shaders ---
# Trail: cursor_blaze (0xhckr/ghostty-shaders)
# Boom:  sonic_boom on cursor-mode change, e.g. vim block <-> line
#        (sahaj-b/ghostty-cursor-shaders)
custom-shader = ~/.config/ghostty/shaders/cursor_blaze.glsl
custom-shader = ~/.config/ghostty/shaders/sonic_boom_cursor.glsl
# Keep boom playing when the window loses focus (cursor goes hollow otherwise)
custom-shader-animation = always

# --- Clipboard / mouse ---
clipboard-read = allow
clipboard-write = allow
clipboard-paste-protection = true
clipboard-paste-bracketed-safe = true
clipboard-trim-trailing-spaces = true
copy-on-select = clipboard
mouse-hide-while-typing = true
mouse-scroll-multiplier = 1.5

# --- Shell / multiplexer ---
# No `command` override: Ghostty launches an interactive login zsh, which
# sources ~/.zshrc — that's where the multiplexer (herdr) auto-starts, so the
# same behaviour applies to every zsh (VSCode terminal, wezterm, ssh, ...).
# `zsh -l -c <cmd>` is non-interactive and skips ~/.zshrc, hence not used.
# command = /bin/zsh -l -c zellij
shell-integration = zsh
shell-integration-features = cursor,sudo,title

# --- Quick Terminal ---
# Default quick-terminal height is too short for zellij's min layout size
# (needs 24 rows; default gave ~13), so "Open the Quick Terminal" shortcut
# actions would launch zellij/spf but it'd abort with "Terminal size too
# small". 60% of screen height gives plenty of room.
quick-terminal-size = 60%

# --- macOS / input ---
# Right Option = Alt so terminal Alt bindings (herdr/zellij Alt-h/j/k/l, etc.)
# fire; left Option keeps native macOS composed keys (å, ∂, ™...). Note this is
# the reverse of wezterm's send_composed_key_when_* settings.
macos-option-as-alt = right

# Convenience keys mirroring wezterm's CTRL|SHIFT R / CTRL|SHIFT Z
keybind = super+shift+r=reload_config
keybind = super+shift+z=text:zellij\n

# Hand cmd+1..9 to herdr (switch_workspace = "cmd+1..9" in
# ~/.config/herdr/config.toml). Ghostty binds these to goto_tab/last_tab by
# default in BOTH the logical (super+N) and physical (super+digit_N) form, so
# both must be unbound or the keys never reach the app. herdr owns tabs now,
# so losing Ghostty's native tab switching costs nothing.
# ctrl+1..9 (herdr focus_agent) needs no unbind — Ghostty doesn't claim it.
keybind = super+1=unbind
keybind = super+2=unbind
keybind = super+3=unbind
keybind = super+4=unbind
keybind = super+5=unbind
keybind = super+6=unbind
keybind = super+7=unbind
keybind = super+8=unbind
keybind = super+9=unbind
keybind = super+digit_1=unbind
keybind = super+digit_2=unbind
keybind = super+digit_3=unbind
keybind = super+digit_4=unbind
keybind = super+digit_5=unbind
keybind = super+digit_6=unbind
keybind = super+digit_7=unbind
keybind = super+digit_8=unbind
keybind = super+digit_9=unbind

# Hand cmd+shift+g to nvim (<D-S-g> = lazygit in
# nvim/lua/config/keymaps.lua). Ghostty binds it to navigate_search:previous by
# default, which swallows the chord before nvim ever sees it. Cost: Ghostty's
# terminal-search "find previous" loses its shortcut. super+g (find next) is
# left bound, so the pair is asymmetric on purpose — only the half nvim needs
# is given up.
keybind = super+shift+g=unbind

# Hand ctrl+tab to nvim (<C-Tab> = BufferLinePick in
# nvim/lua/config/keymaps.lua). Ghostty binds it to next_tab by default. Same
# rationale as the cmd+1..9 unbinds above: herdr owns tabs, so Ghostty's native
# tab cycling is dead weight here. ctrl+shift+tab (previous_tab) is left bound
# — nothing in nvim wants it.
keybind = ctrl+tab=unbind

# --- Misc ---
scrollback-limit = 10000000
