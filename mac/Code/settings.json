{
    // "terminal.external.osxExec": "WezTerm.app",
    // Editor settings
    "editor.wordWrap": "on",
    "editor.minimap.enabled": false,
    "editor.foldingStrategy": "indentation",
    "editor.formatOnSave": true,
    "editor.fontSize": 14,
    "editor.copyWithSyntaxHighlighting": false,
    "editor.tabCompletion": "on",
    "editor.tabFocusMode": false,
    "editor.inlineCompletionsAccessibilityVerbose": true,
    "diffEditor.codeLens": true,
    // cursor customizations
    "editor.cursorSmoothCaretAnimation": "explicit",
    "editor.cursorBlinking": "smooth",
    "editor.cursorWidth": 2,
    "editor.smoothScrolling": true,
    "workbench.list.smoothScrolling": true,
    "terminal.integrated.smoothScrolling": true,
    // terminal settings
    "terminal.external.osxExec": "Ghostty.app",
    "terminal.integrated.fontSize": 15,
    "terminal.integrated.sendKeybindingsToShell": false,
    "terminal.integrated.commandsToSkipShell": [
        "workbench.action.terminal.focusPrevious",
        "workbench.action.terminal.focusNext",
        "workbench.action.quickOpen",
        "workbench.action.nextAuxiliaryBarView",
        "workbench.action.toggleMaximizedAuxiliaryBar"
    ],
    // python settings
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "python.languageServer": "Pylance",
    "pylint.args": [
        "--disable=await-outside-async,redefined-outer-name"
    ],
    // To improve performance
    "extensions.experimental.affinity": {
        "vscodevim.vim": 1,
        "asvetliakov.vscode-neovim": 1
    },
    "terminal.integrated.macOptionIsMeta": true,
    "workbench.activityBar.location": "top",
    "workbench.sideBar.location": "left",
    "pgsql.serverGroups": [
        {
            "name": "Servers",
            "id": "240604AC-F8B6-4B2B-9E42-3FDF567F2D56",
            "isDefault": true
        }
    ],
    // "workbench.colorTheme": "Catppuccin Macchiato",
    // SQL customizations
    "[sql]": {
        "editor.formatOnSave": false
    },
    "pgsql.connections": [
        {
            "id": "7828B466-E427-420C-B3FE-0BAFD9FB7D43",
            "groupId": "240604AC-F8B6-4B2B-9E42-3FDF567F2D56",
            "authenticationType": "SqlLogin",
            "connectTimeout": 55,
            "applicationName": "vscode-pgsql",
            "clientEncoding": "utf8",
            "sslmode": "require",
            "sshSavePassword": true,
            "savePassword": true,
            "sslRootCertMode": "none",
            "server": "aws-0-eu-west-2.pooler.supabase.com",
            "user": "postgres.pqsvhidiwiydgshynfib",
