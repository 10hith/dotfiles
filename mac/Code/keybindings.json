// Place your key bindings in this file to override the defaults
[
    // quick open navigation
    {
        "key": "cmd+j",
        "command": "workbench.action.quickOpenNavigateNext",
        "when": "inQuickOpen"
    },
    {
        "key": "cmd+k",
        "command": "workbench.action.quickOpenNavigatePrevious",
        "when": "inQuickOpen"
    },
    {
        "key": "^+j",
        "command": "workbench.action.quickOpenNavigateNext",
        "when": "inQuickOpen"
    },
    {
        "key": "^+k",
        "command": "workbench.action.quickOpenNavigatePrevious",
        "when": "inQuickOpen"
    },
    // editor pane navigation
    {
        "key": "; h",
        "command": "workbench.action.navigateLeft",
        "when": "neovim.mode != insert"
    },
    {
        "key": "; l",
        "command": "workbench.action.navigateRight",
        "when": "neovim.mode != insert"
    },
    {
        "key": "; k",
        "command": "workbench.action.navigateUp",
        "when": "neovim.mode != insert"
    },
    {
        "key": "; j",
        "command": "workbench.action.navigateDown",
        "when": "neovim.mode != insert"
    },
    // terminal navigation
    {
        "key": "alt-k",
        "command": "workbench.action.terminal.focusPrevious",
        "when": "terminalFocus"
    },
    {
        "key": "alt-j",
        "command": "workbench.action.terminal.focusNext",
        "when": "terminalFocus"
    },
    {
        "key": "cmd+l t",
        "command": "runCommands",
        "args": {
            "commands": [
                "workbench.action.terminal.toggleTerminal",
                {
                    "command": "workbench.action.terminal.sendSequence",
                    "args": {
                        "text": "\u001B[200~cat << 'EOF'\u000A# VS Code Context\u000A\u000AFile:${file}:${lineNumber}\u000A\u000A```\u000A${selectedText}\u000A```\u000AEOF\u000A\u001B[201~"
                    }
                }
            ]
        },
        "when": "editorTextFocus && editorHasSelection"
    },
    {
        "key": "cmd+l r",
        "command": "runCommands",
        "args": {
            "commands": [
                {
                    "command": "workbench.action.terminal.sendSequence",
                    "args": {
                        "text": "${selectedText}\n"
                    }
                },
            ]
        },
        "when": "editorTextFocus && editorHasSelection"
    },
    // Terminal toggle
    {
        "key": "ctrl+'",
        "command": "workbench.action.terminal.toggleTerminal",
        "when": "terminal.active"
    },
    {
        "key": "ctrl+shift+'",
        "command": "workbench.action.toggleMaximizedAuxiliaryBar",
        "when": "auxiliaryBarVisible || terminal.visible"
    },
    // Jupyter + pgsql commands
    {
        "key": "cmd+enter",
        "command": "jupyter.runcurrentcell",
        "when": "editorTextFocus && isWorkspaceTrusted && jupyter.hascodecells && !editorHasSelection && !isCompositeNotebook && !notebookEditorFocused"
    },
    {
        "key": "ctrl+oem_1 k",
        "command": "jupyter.runallcellsabove.palette",
        "when": "isWorkspaceTrusted && editorTextFocus && editorLangId == 'python'"
    },
    {
        "key": "cmd+enter",
        "command": "pgsql.runCurrentStatement",
        "when": "editorTextFocus && editorLangId == 'sql'"
    },
    {
        "key": "ctrl+oem_1 r",
        "command": "jupyter.restartkernel",
        "when": "isWorkspaceTrusted && jupyter.interactive.canRestartNotebookKernel || isWorkspaceTrusted && jupyter.notebookeditor.canrestartNotebookkernel && notebookKernel =~ /^ms-toolsai.jupyter\\//"
    },
    {
        "key": "cmd+l l",
        "command": "claude-vscode.insertAtMention",
        "when": "editorTextFocus && claude-vscode.sideBarActive"
    },
    {
        "key": "alt+k",
        "command": "-claude-vscode.insertAtMention",
        "when": "editorTextFocus"
    },
    {
        "key": "cmd+l i",
        "command": "claude-vscode.focus",
        "when": "editorTextFocus && !config.claudeCode.useTerminal && claude-vscode.sideBarActive"
    },
    {
        "key": "cmd+escape",
        "command": "-claude-vscode.focus",
        "when": "editorTextFocus && !config.claudeCode.useTerminal"
    },
    {
        "key": "ctrl+alt+j",
        "command": "workbench.action.nextAuxiliaryBarView"
    },
    {
        "key": "ctrl+alt+k",
        "command": "workbench.action.previousAuxiliaryBarView"
    },
    {
        "key": "cmd+l i",
        "command": "chatgpt.sidebarSecondaryView.focus",
        "when": "chatgpt.sidebarView.visible && editorTextFocus"
    },
    {
        "key": "cmd+l l",
        "command": "chatgpt.addToThread",
        "when": "editorTextFocus && chatgpt.sidebarView.visible"
    },
    {
        "key": "shift+cmd+e",
        "command": "-pgsql.runQuery",
        "when": "editorTextFocus && editorLangId == 'sql'"
    },
    {
        "key": "shift+enter",
        "command": "-pgsql.runQuery",
        "when": "editorTextFocus && editorLangId == 'sql'"
    }
]