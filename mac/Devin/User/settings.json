{
    // "terminal.external.osxExec": "WezTerm.app",
    // Editor settings
    "editor.wordWrap": "on",
    "editor.minimap.enabled": false,
    "editor.foldingStrategy": "indentation",
    "editor.formatOnSave": true,
    "editor.fontSize": 16,
    "editor.copyWithSyntaxHighlighting": false,
    "editor.tabCompletion": "on",
    "editor.tabFocusMode": false,
    "editor.inlineCompletionsAccessibilityVerbose": true,
    "diffEditor.codeLens": true,
    // cursor customizations
    "editor.cursorSmoothCaretAnimation": "explicit",
    "editor.cursorBlinking": "smooth",
    "editor.cursorWidth": 2,
    "editor.smoothScrolling": true,
    "workbench.list.smoothScrolling": true,
    "terminal.integrated.smoothScrolling": true,
    // terminal settings
    "terminal.external.osxExec": "Ghostty.app",
    "terminal.integrated.fontSize": 17,
    "terminal.integrated.sendKeybindingsToShell": false,
    "terminal.integrated.commandsToSkipShell": [
        "workbench.action.terminal.focusPrevious",
        "workbench.action.terminal.focusNext",
        "workbench.action.quickOpen",
        "workbench.action.nextAuxiliaryBarView",
        "workbench.action.toggleMaximizedAuxiliaryBar"
    ],
    // python settings
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "python.languageServer": "None",
    // To improve performance
    "extensions.experimental.affinity": {
        "vscodevim.vim": 1,
        "asvetliakov.vscode-neovim": 1
    },
    "terminal.integrated.macOptionIsMeta": true,
    // "vim.handleKeys": {
    //     "<C-p>": false,
    //     "<C-;>": true,
    //     "<C-a>": false,
    //     "<C-c>": false,
    //     "<C-f>": false,
    //     "<C-w>": false,
    // },
    "workbench.activityBar.location": "top",
    "workbench.sideBar.location": "left",
    // Vim settings
    "vim.leader": "<space>",
    "vim.timeout": 300,
    "vim.incsearch": true,
    // "vim.useCtrlKeys": true,
    "vim.hlsearch": true,
    "vim.surround": true,
    "vim.foldfix": true,
    "vim.useSystemClipboard": true,
    "vim.normalModeKeyBindingsNonRecursive": [
        {
            "before": [
                "y",
                "l"
            ],
            "commands": [
                "github.copyVscodeDevLink"
            ]
        },
        {
            "before": [
                "H"
            ],
            "after": [
                "{"
            ]
        },
        {
            "before": [
                "L"
            ],
            "after": [
                "L",
                "z",
                "z"
            ]
        },
        {
            "before": [
                "ctrl+j"
            ],
            "commands": [
                ":reg"
            ],
            "silent": true
        },
        {
            "before": [
                "ctrl+m"
            ],
            "commands": [
                ":marks"
            ],
            "silent": true
        },
        {
            "before": [
                "K"
            ],
            "commands": [
                "lineBreakInsert"
            ],
            "silent": true
        },
        {
            "before": [
                "4"
            ],
            "commands": [
                ":/# %%",
                ":normal! zz"
            ],
            "silent": true
        },
        {
            "before": [
                "6"
            ],
            "after": [
                "?",
                "# ",
                "%",
                "%",
                "<CR>",
                "z",
                "z"
            ],
            "silent": true
        },
        {
            "before": [
                "'"
            ],
            "after": [
                "`"
            ]
        },
    ],
    "vim.operatorPendingModeKeyBindingsNonRecursive": [
        {
            "before": [
                "'"
            ],
            "after": [
                "`"
            ]
        }
    ],
