{
    // Editor settings
    "editor.wordWrap": "on",
    "editor.minimap.enabled": false,
    "editor.foldingStrategy": "indentation",
    "editor.formatOnSave": true,
    "editor.fontSize": 16,
    "editor.copyWithSyntaxHighlighting": false,
    "editor.tabCompletion": "on",
    "editor.tabFocusMode": false,
    "editor.inlineCompletionsAccessibilityVerbose": true,
    "diffEditor.codeLens": true,
    // terminal settings
    "terminal.external.osxExec": "WezTerm.app",
    "terminal.integrated.fontSize": 17,
    "terminal.integrated.sendKeybindingsToShell": false,
    "terminal.integrated.tabFocusMode": false,
    "terminal.integrated.commandsToSkipShell": [
        "workbench.action.terminal.focusPrevious",
        "workbench.action.terminal.focusNext"
    ],
    // python settings
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "python.languageServer": "None",
    "python.analysis.extraPaths": [
        "${workspaceFolder}"
    ],
    // Vim settings
    "vim.leader": "<space>",
    "vim.timeout": 300,
    "vim.incsearch": true,
    // To improve performance
    "extensions.experimental.affinity": {
        "vscodevim.vim": 1
    },
    // "vim.useCtrlKeys": true,
    "vim.hlsearch": true,
    "vim.surround": true,
    "vim.easymotion": true,
    "vim.foldfix": true,
    "vim.useSystemClipboard": true,
    "vim.normalModeKeyBindingsNonRecursive": [
        {
            "before": [
                "y",
                "l"
            ],
            "commands": [
                "github.copyVscodeDevLink"
            ]
        },
        {
            "before": [
                "H"
            ],
            "after": [
                "{"
            ]
        },
        {
            "before": [
                "L"
            ],
            "after": [
                "L",
                "z",
                "z"
            ]
        },
        {
            "before": [
                "ctrl+j"
            ],
            "commands": [
                ":reg"
            ],
            "silent": true
        },
        {
            "before": [
                "ctrl+m"
            ],
            "commands": [
                ":marks"
            ],
            "silent": true
        },
        {
            "before": [
                "K"
            ],
            "commands": [
                "lineBreakInsert"
            ],
            "silent": true
        },
        {
            "before": [
                "4"
            ],
            "commands": [
                ":/# %%",
                ":normal! zz"
            ],
            "silent": true
        },
        {
            "before": [
                "6"
            ],
            "after": [
                "?",
                "# ",
                "%",
                "%",
                "<CR>",
                "z",
                "z"
            ],
            "silent": true
        }
    ],
    "vim.handleKeys": {
        "<C-p>": false,
        "<C-a>": false,
        "<C-c>": false,
        "<C-f>": false,
        "<C-w>": false,
        // "<C-h>": false,
        // "<C-l>": false
    },
    "workbench.activityBar.location": "top",
    "workbench.sideBar.location": "left",
    "pgsql.serverGroups": [
        {
            "name": "Servers",
            "id": "240604AC-F8B6-4B2B-9E42-3FDF567F2D56",
            "isDefault": true
        }
    ],
    "workbench.colorTheme": "Catppuccin Macchiato",
    // cursor customizations
    "editor.cursorWidth": 2, // Increase the cursor thickness/width (works for line cursor)
    "editor.cursorBlinking": "smooth",
    // SQL customizations
    "[sql]": {
        "editor.formatOnSave": false
    },
    "pgsql.connections": [
        {
            "id": "7828B466-E427-420C-B3FE-0BAFD9FB7D43",
            "groupId": "240604AC-F8B6-4B2B-9E42-3FDF567F2D56",
            "authenticationType": "SqlLogin",
            "connectTimeout": 15,
            "applicationName": "vscode-pgsql",
            "clientEncoding": "utf8",
            "sslmode": "require",
            "sshSavePassword": true,
            "savePassword": true,
            "sslRootCertMode": "none",
            "server": "aws-0-eu-west-2.pooler.supabase.com",
            "user": "postgres.pqsvhidiwiydgshynfib",
            "password": "",
            "profileName": "ordelo, <default> (postgres.pqsvhidiwiydgshynfib)",
            "expiresOn": 0,
            "sshPassword": ""
        }
    ]
}