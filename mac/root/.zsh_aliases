# ~/.zsh_aliases

# ── Directory navigation ──────────────────────────────────────────────────────
# Pattern: gT<name> = cd to project directory (update paths for Mac)
# alias gTmyproject='cd ~/repos/myproject'

# ── Color support ─────────────────────────────────────────────────────────────
export CLICOLOR=1
export LSCOLORS=ExFxBxDxCxegedabagacad
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'

# ── eza (modern ls) ───────────────────────────────────────────────────────────
# Auto-installs via Homebrew on first launch (same idea as .zsh_plugins).
# Falls back to BSD ls aliases if eza is still unavailable.
if ! command -v eza >/dev/null 2>&1 && command -v brew >/dev/null 2>&1; then
  echo "Installing eza..."
  brew install eza || echo "ERROR: failed to install eza" >&2
fi

if command -v eza >/dev/null 2>&1; then
  alias ls='eza --icons=always --group-directories-first'
  alias la='eza --all --icons=always --group-directories-first'
  alias ll='eza --long --all --git --icons=always --group-directories-first'
  alias l='eza --classify --icons=always --group-directories-first'
  alias tree='eza --tree --icons'
else
  alias ls='ls -G'
  alias ll='ls -alF'
  alias la='ls -A'
  alias l='ls -CF'
fi

# ── Modern CLI replacements ───────────────────────────────────────────────────
alias cat='bat'
alias grep='rg --color=auto'

# ── AWS profiles ──────────────────────────────────────────────────────────────
alias awsBtl='export AWS_PROFILE=byteloop && echo "Switched to ByteLoop"'
alias awsErr='export AWS_PROFILE=err && echo "Switched to Err"'
alias awsErai='export AWS_PROFILE=erai && echo "Switched to Erai"'

# ── UI applications (macOS) ───────────────────────────────────────────────────
alias charm='open -a "PyCharm"'
alias idea='open -a "IntelliJ IDEA"'
alias dbeaver='open -a "DBeaver"'

# ── Automation (macOS) ────────────────────────────────────────────────────────
# Keep the Citrix session from idling out (Ctrl+C to stop). See mac/automation/README.md
alias citrix-keep-alive='caffeinate -d uv run ~/dotfiles/mac/automation/keep_active.py'

# ── Git — basics ──────────────────────────────────────────────────────────────
alias gs='git status'
alias ga='git add'
alias gaa='git add --all'
alias gc='git commit'
alias gcm='git commit -m'
alias gca='git commit --amend'

# ── Git — branches ────────────────────────────────────────────────────────────
alias gb='git branch'
alias gbd='git branch -d'
alias gco='git checkout'
alias gcb='git checkout -b'
alias gsw='git switch'

# ── Git — remote ──────────────────────────────────────────────────────────────
alias gp='git pull'
alias gP='git push'
alias gPf='git push --force-with-lease'
alias gf='git fetch'
alias gfa='git fetch --all'

# ── Git — log ─────────────────────────────────────────────────────────────────
alias gl='git log --oneline'

# ── Git — TUI ─────────────────────────────────────────────────────────────────
alias lg='lazygit'

# ── Git — restore ─────────────────────────────────────────────────────────────
alias grs='git restore'
alias grss='git restore --staged'

# ── Docker ────────────────────────────────────────────────────────────────────
alias dps='docker ps'
alias dpsa='docker ps -a'
alias di='docker images'
alias drmi='docker rmi -f'

# ── Misc ──────────────────────────────────────────────────────────────────────
alias reload='source ~/.zshrc'
alias aliases='cat ~/.zsh_aliases'
alias y='yazi'
alias n='nvim'

# ── Dev workflow ──────────────────────────────────────────────────────────────
alias setPyPath='export PYTHONPATH=$(pwd)'

# just — smart runner: `j py` activates venv; everything else delegates to just
j() {
    case "$1" in
        py)
            [[ -d "venv" ]] && source venv/bin/activate || \
            [[ -d ".venv" ]] && source .venv/bin/activate || \
            echo "No virtual env found"
            export PYTHONPATH=$(pwd)
            [[ -f ".env" ]] && envLoad
            ;;
        *) just "$@" ;;
    esac
}
alias jj='just --justfile ~/.justfile'
