# ~/.zsh_plugins — self-managed plugin loader

ZPLUGINDIR="$HOME/.zsh/plugins"

_zplugin_load() {
  local plugin_path="${ZPLUGINDIR}/${2}"
  if [[ ! -d "$plugin_path" ]]; then
    mkdir -p "$ZPLUGINDIR"
    echo "Installing ${2}..."
    git clone --depth=1 "https://github.com/${1}/${2}" "$plugin_path" \
      || { echo "ERROR: failed to install ${2}" >&2; return 1; }
  fi
  source "${plugin_path}/${2}.plugin.zsh"
}

zplugin-update() {
  local dir
  for dir in "${ZPLUGINDIR}"/*/; do
    echo "Updating ${dir:t}..."
    git -C "$dir" pull --ff-only
  done
}

# ── Autosuggestions: deja (falls back to zsh-autosuggestions) ─────────────────
# deja needs its binary; auto-install via Homebrew on first launch and import
# existing zsh history once. Without Homebrew (Ubuntu), install it manually —
# see setup_ubuntu.md. Never load both — deja stands down if it sees
# zsh-autosuggestions.
# The curl installer puts deja in ~/.local/bin, which .zshrc only adds to PATH
# after this file is sourced.
(( ! $+commands[deja] )) && [[ -x "$HOME/.local/bin/deja" ]] && path+=("$HOME/.local/bin")

if (( ! $+commands[deja] )) && (( $+commands[brew] )); then
  echo "Installing deja binary via Homebrew..."
  { brew install Giammarco-Ferranti/deja/deja && deja import; } \
    || echo "ERROR: failed to install deja" >&2
fi

if (( $+commands[deja] )); then
  # Key overrides — must be exported before deja loads. Empty = unbound.
  export DEJA_ACCEPT_KEY='^L'          # Ctrl+L accepts (→ still accepts too)
  export DEJA_CYCLE_KEY='^N'           # Ctrl+N cycles alternatives; frees Tab
  export DEJA_CYCLE_FUZZY_KEY=
  export DEJA_CYCLE_FUZZY_BACK_KEY=
  export DEJA_TOGGLE_EMPTY_KEY=
  _zplugin_load Giammarco-Ferranti deja
else
  _zplugin_load zsh-users zsh-autosuggestions
fi

_zplugin_load zsh-users zsh-history-substring-search
_zplugin_load zdharma-continuum fast-syntax-highlighting

# Must bind after zsh-history-substring-search is loaded.
# Bind in both vi keymaps — plain bindkey only covers emacs/viins.
bindkey -M viins '^[[A' history-substring-search-up
bindkey -M viins '^[[B' history-substring-search-down
bindkey -M vicmd '^[[A' history-substring-search-up
bindkey -M vicmd '^[[B' history-substring-search-down
