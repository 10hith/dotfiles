{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "bashOps"
    ]
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/home/basal/.claude/hooks/pre-tool-logger.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/home/basal/.claude/hooks/post-tool-logger.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "/home/basal/.claude/statusline-command.sh"
  },
  "VISUAL": "windsurf"
}
