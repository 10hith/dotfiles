{
    // Editor settings
    "editor.wordWrap": "on",
    "editor.minimap.enabled": false,
    "editor.foldingStrategy": "indentation",
    "editor.formatOnSave": true,
    "editor.fontSize": 16,
    "editor.copyWithSyntaxHighlighting": false,
    "editor.tabCompletion": "on",
    "editor.tabFocusMode": false,
    "editor.inlineCompletionsAccessibilityVerbose": true,
    "diffEditor.codeLens": true,
    // terminal settings
    "terminal.integrated.sendKeybindingsToShell": false,
    "terminal.integrated.tabFocusMode": false,
    "terminal.integrated.commandsToSkipShell": [
        "workbench.action.terminal.focusPrevious",
        "workbench.action.terminal.focusNext"
    ],
    // python settings
    "python.languageServer": "None",
    // Vim settings
    "vim.leader": "<space>",
    "vim.incsearch": true,
    // "vim.useCtrlKeys": true,
    "vim.hlsearch": true,
    "vim.surround": true,
    "vim.smartRelativeLine": true,
    "vim.easymotion": true,
    "vim.foldfix": true,
    "vim.useSystemClipboard": true,
    "vim.normalModeKeyBindingsNonRecursive": [
        {
            "before": [
                "y",
                "l"
            ],
            "commands": [
                "github.copyVscodeDevLink"
            ]
        },
        {
            "before": [
                "H"
            ],
            "after": [
                "{"
            ]
        },
        {
            "before": [
                "L"
            ],
            "after": [
                "L",
                "z",
                "z"
            ]
        },
        {
            "before": [
                "ctrl+j"
            ],
            "commands": [
                ":reg"
            ],
            "silent": true
        },
        {
            "before": [
                "ctrl+m"
            ],
            "commands": [
                ":marks"
            ],
            "silent": true
        },
        {
            "before": [
                "K"
            ],
            "commands": [
                "lineBreakInsert"
            ],
            "silent": true
        },
        {
            "before": [
                "4"
            ],
            "commands": [
                ":/# %%",
                ":normal! zz"
            ],
            "silent": true
        },
        {
            "before": [
                "6"
            ],
            "after": [
                "?",
                "# ",
                "%",
                "%",
                "<CR>",
                "z",
                "z"
            ],
            "silent": true
        }
    ],
    "vim.handleKeys": {
        "<C-a>": false,
        "<C-c>": false,
        "<C-f>": false,
        "<C-w>": false,
        // "<C-h>": false,
        // "<C-l>": false
    },
    // imporve performance
    "extensions.experimental.affinity": {
        "vscodevim.vim": 1
    },
    // Editor Associations
    "workbench.editorAssociations": {
        "*.ipynb": "jupyter-notebook",
        "*.md": "vscode.markdown.preview.editor"
    },
    // jupyter
    "jupyter.interactiveWindow.creationMode": "single",
    "jupyter.askForKernelRestart": false,
    "jupyter.allowUnauthorizedRemoteConnection": true,
    // Other settings
    "windsurf.marketplaceGalleryItemURL": "",
    "git.ignoreMissingGitWarning": true,
    // workbench customizations
    "workbench.colorCustomizations": {
        "editorCursor.foreground": "#FF0000",
        "editorCursor.background": "#222222",
        "editorCursor.border": "#FF0000"
    },
    // cursor customizations
    "editor.cursorWidth": 2, // Increase the cursor thickness/width (works for line cursor)
    "editor.cursorBlinking": "smooth",
    "[sql]": {
        "editor.formatOnSave": false
    },
    // Other settings
    "remote.windsurfSSH.configFile": "https://open-vsx.org/vscode/item",
    "colorful-comments-refreshed.tags": [
        {
            "tag": "%%",
            "color": "#EAF622",
            "strikethrough": false,
            "backgroundColor": "transparent"
        },
        {
            "tag": "#",
            "color": "#FF9900",
            "strikethrough": false,
            "backgroundColor": "transparent"
        }
    ],
    "remote.autoForwardPortsSource": "hybrid",
    "git.confirmSync": false,
    "git.enableSmartCommit": true,
    "workbench.colorTheme": "Catppuccin Mocha",
    "workbench.activityBar.location": "top",
