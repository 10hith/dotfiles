// Place your key bindings in this file to override the defaults
[
    // quick open navigation
    {
        "key": "ctrl+j",
        "command": "workbench.action.quickOpenNavigateNext",
        "when": "inQuickOpen"
    },
    {
        "key": "ctrl+k",
        "command": "workbench.action.quickOpenNavigatePrevious",
        "when": "inQuickOpen"
    },
    // editor pane navigation
    {
        "key": "alt-h",
        "command": "workbench.action.navigateLeft"
    },
    {
        "key": "alt-l",
        "command": "workbench.action.navigateRight"
    },
    {
        "key": "alt-k",
        "command": "workbench.action.navigateUp"
    },
    {
        "key": "alt-j",
        "command": "workbench.action.navigateDown"
    },
    // Terminal navigation
    {
        "key": "alt-k",
        "command": "workbench.action.terminal.focusPrevious",
        "when": "terminalFocus"
    },
    {
        "key": "alt-j",
        "command": "workbench.action.terminal.focusNext",
        "when": "terminalFocus"
    },
    {
        "key": "ctrl+oem_1",
        "command": "workbench.action.maximizeAuxiliaryBar",
        "when": "terminalViewShowing"
    },
    // Terminal - Sending or running text to terminal
    {
        "key": "ctrl+l t",
        "command": "runCommands",
        "args": {
            "commands": [
                "workbench.action.terminal.toggleTerminal",
                {
                    "command": "workbench.action.terminal.sendSequence",
                    "args": {
                        "text": "cat << 'EOF'\u000D# VS Code Context\u000D\u000DFile:${file}:${lineNumber}\u000D\u000D```\u000D${selectedText}\u000D```\u000DEOF\u000D"
                    }
                }
            ]
        },
        "when": "editorTextFocus && editorHasSelection"
    },
    {
        "key": "ctrl+l r",
        "command": "runCommands",
        "args": {
            "commands": [
                {
                    "command": "workbench.action.terminal.sendSequence",
                    "args": {
                        "text": "${selectedText}\n"
                    }
                },
            ]
        },
        "when": "editorTextFocus && editorHasSelection"
    },
    // Terminal - bypassing vscode certain vscode keys for terminal commands to take effect
    {
        "key": "ctrl+p",
        "command": "-workbench.action.quickOpen"
    },
    {
        "key": "ctrl+p",
        "command": "workbench.action.quickOpen",
        "when": "!terminalFocus"
    },
    {
        "key": "ctrl+g",
        "command": "-workbench.action.gotoLine",
        "when": "terminalFocus"
    },
    {
        "key": "ctrl+g",
        "command": "-workbench.action.terminal.goToRecentDirectory",
        "when": "terminalFocus && terminalHasBeenCreated || terminalFocus && terminalProcessSupported"
    },
    // breadcrumbs
    {
        "key": "ctrl+shift+;",
        "command": "runCommands",
        "args": {
            "commands": [
                "breadcrumbs.focus",
                "breadcrumbs.focusPrevious",
                "breadcrumbs.selectFocused"
            ]
        }
    },
    {
        "key": "alt+l",
        "command": "breadcrumbs.focusNextWithPicker",
        "when": "breadcrumbsActive && breadcrumbsVisible && listFocus && !inputFocus && !treestickyScrollFocused"
    },
    {
        "key": "alt+h",
        "command": "breadcrumbs.focusPreviousWithPicker",
        "when": "breadcrumbsActive && breadcrumbsVisible && listFocus && !inputFocus && !treestickyScrollFocused"
    },
    // review impact
    // {
    //     "key": "ctrl+p",
    //     "command": "-extension.vim_ctrl+p",
    //     "when": "editorTextFocus && vim.active && vim.use<C-p> && !inDebugRepl || vim.active && vim.use<C-p> && !inDebugRepl && vim.mode == 'CommandlineInProgress' || vim.active && vim.use<C-p> && !inDebugRepl && vim.mode == 'SearchInProgressMode'"
    // },
    // {
    //     "key": "ctrl+l u",
    //     "command": "windsurf.prioritized.command.open",
    //     "when": "editorTextFocus"
    // },
    // Side bar docking
    {
        "key": "ctrl+b",
        "command": "-extension.vim_ctrl+b",
        "when": "editorTextFocus && vim.active && vim.use<C-b> && !inDebugRepl && vim.mode != 'Insert'"
    },
    // Jupyter navigation
    {
        "key": "ctrl+oem_1 k",
        "command": "jupyter.runallcellsabove.palette",
        "when": "isWorkspaceTrusted && editorTextFocus && editorLangId == 'python'"
    },
    {
        "key": "ctrl+enter",
        "command": "pgsql.runCurrentStatement",
        "when": "editorTextFocus && editorLangId == 'sql'"
    },
    {
        "key": "ctrl+oem_1 r",
        "command": "jupyter.restartkernel",
        "when": "isWorkspaceTrusted && jupyter.interactive.canRestartNotebookKernel || isWorkspaceTrusted && jupyter.notebookeditor.canrestartNotebookkernel && notebookKernel =~ /^ms-toolsai.jupyter\\//"
    },
    // windsurf
    {
        "key": "ctrl+i",
        "command": "-windsurf.prioritized.command.open",
        "when": "editorTextFocus"
    },
    {
        "key": "ctrl+l u",
        "command": "windsurf.interactiveCascade.focusEditIntent",
        "when": "windsurf.interactiveCascade.enabled && !editorReadonly"
    },
    {
        "key": "ctrl+l u",
        "command": "windsurf.prioritized.command.open",
        "when": "editorTextFocus && !windsurf.interactiveCascade.enabled"
    },
    {
        "key": "ctrl+shift+e",
        "command": "-pgsql.runQuery",
        "when": "editorTextFocus && editorLangId == 'sql'"
    },
    // {
    //     "key": "alt+enter",
    //     "command": "workbench.action.terminal.runSelectedText",
    //     "when": "terminalProcessSupported"
    // },
    {
        "key": "ctrl+oem_4",
        "command": "-extension.vim_ctrl+[",
        "when": "editorTextFocus && vim.active && vim.use<C-[> && !inDebugRepl"
    },
    {
        "key": "ctrl+oem_4",
        "command": "-editor.action.outdentLines",
        "when": "editorTextFocus && !editorReadonly"
    },
    {
        "key": "ctrl+oem_4",
        "command": "extension.vim_ctrl+[",
        "when": "editorTextFocus && vim.active && vim.use<C-[> && !inDebugRepl"
    },
    {
        "key": "ctrl+l l",
        "command": "windsurf.prioritized.chat.open"
    },
    {
        "key": "ctrl+l",
        "command": "-windsurf.prioritized.chat.open",
        "when": "!terminalFocus"
    },
    {
        "key": "shift+l",
        "command": "-notebook.toggleLineNumbers",
        "when": "notebookEditorFocused && !inputFocus && !notebookOutputInputFocused"
    },
    {
        "key": "ctrl+u",
        "command": "-cursorUndo",
        "when": "textInputFocus"
    },
    {
        "key": "ctrl+h",
        "command": "-editor.action.startFindReplaceAction",
        "when": "editorFocus || editorIsOpen"
    },
    {
        "key": "ctrl+l i",
        "command": "inlineChat.start",
        "when": "editorFocus && inlineChatHasEditsAgent && inlineChatPossible && !editorReadonly && !editorSimpleInput || editorFocus && inlineChatHasProvider && inlineChatPossible && !editorReadonly && !editorSimpleInput"
    },
    {
        "key": "ctrl+i",
        "command": "-inlineChat.start",
        "when": "editorFocus && inlineChatHasEditsAgent && inlineChatPossible && !editorReadonly && !editorSimpleInput || editorFocus && inlineChatHasProvider && inlineChatPossible && !editorReadonly && !editorSimpleInput"
    },
    {
        "key": "ctrl+shift+t",
        "command": "-workbench.action.reopenClosedEditor"
    },
    {
        "key": "ctrl+i",
        "command": "-windsurf.prioritized.command.open",
        "when": "editorTextFocus && !windsurf.interactiveCascade.enabled && !windsurf.isAgentModeInputBoxFocused"
    },
    {
        "key": "ctrl+shift+.",
        "command": "-breadcrumbs.focusAndSelect",
        "when": "breadcrumbsPossible && breadcrumbsVisible"
    },
    {
        "key": "ctrl+shift+oem_period",
        "command": "-breadcrumbs.toggleToOn",
        "when": "!config.breadcrumbs.enabled"
    },
    {
        "key": "ctrl+l g",
        "command": "windsurf.generateCodeMap",
        "when": "codemapsEnabled"
    },
    {
        "key": "ctrl+shift+g",
        "command": "-windsurf.generateCodeMap",
        "when": "codemapsEnabled"
    },
    // {
    //     "key": "ctrl+l g",
    //     "command": "windsurf.generateCodeMapFromContext",
    //     "when": "codemapsEnabled && editorTextFocus"
    // },
    {
        "key": "ctrl+shift+g",
        "command": "-windsurf.generateCodeMapFromContext",
        "when": "codemapsEnabled && editorTextFocus"
    },
    {
        "key": "ctrl+l i",
        "command": "windsurf.prioritized.command.open",
        "when": "editorTextFocus && !windsurf.isAgentModeInputBoxFocused"
    },
    {
        "key": "ctrl+i",
        "command": "-windsurf.prioritized.command.open",
        "when": "editorTextFocus && !windsurf.isAgentModeInputBoxFocused"
    },
    {
        "key": "ctrl+alt+b",
        "command": "workbench.action.toggleAuxiliaryBar"
    },
]